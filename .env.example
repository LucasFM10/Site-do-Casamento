# Superusuário do Dashboard do PocketBase. Crie os administradores do site
# pela coleção "admins" no Dashboard após a primeira inicialização.
PB_SUPERUSER_EMAIL=pocketbase@example.com
PB_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# Exatamente 32 caracteres aleatórios; não altere depois de gravar configurações criptografadas
PB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Produção/Coolify: true. Desenvolvimento local em HTTP: false.
AUTH_COOKIE_SECURE=false

# Ajustes opcionais
PB_GOMEMLIMIT=256MiB
WEB_PORT=3000
POCKETBASE_PORT=8090
