{
  "name": "casamento-lucas-amanda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:empacotar": "esbuild scripts/migrar.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/migrar.cjs --log-level=warning",
    "db:migrar": "npm run db:empacotar && node --env-file-if-exists=.env dist/migrar.cjs",
    "test:banco": "npm run db:empacotar && node --test \"tests/banco/*.test.mjs\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^0.462.0",
    "mercadopago": "3.6.1",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
